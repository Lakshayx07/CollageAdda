# Environment Variables for CollegeAdda Backend
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────
# Get a free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/collegeadda?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# ── Cloudinary (Media Uploads) ────────────────────────────
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth ──────────────────────────────────────────
# Client ID to verify tokens from frontend
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Supabase ──────────────────────────────────────────────
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
